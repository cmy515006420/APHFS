{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aphfs.invalid/schema/protected-result-bundle-actual-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "label",
    "role",
    "run_id",
    "protocol_sha256",
    "config_sha256",
    "fidelity_contract_sha256",
    "role_commitment_sha256",
    "manuscript_evidence",
    "protected_execution",
    "final_freeze_record_sha256",
    "runtime_inventory_sha256",
    "benchmark_results"
  ],
  "properties": {
    "schema_version": {"const": "3"},
    "label": {"const": "PROTECTED_RESULT"},
    "role": {"enum": ["calibration", "locked"]},
    "run_id": {"type": "string", "minLength": 1},
    "protocol_sha256": {"pattern": "^[0-9a-f]{64}$"},
    "config_sha256": {"pattern": "^[0-9a-f]{64}$"},
    "fidelity_contract_sha256": {"pattern": "^[0-9a-f]{64}$"},
    "role_commitment_sha256": {"pattern": "^[0-9a-f]{64}$"},
    "manuscript_evidence": {"const": true},
    "protected_execution": {"const": true},
    "final_freeze_record_sha256": {"pattern": "^[0-9a-f]{64}$"},
    "runtime_inventory_sha256": {"pattern": "^[0-9a-f]{64}$"},
    "benchmark_results": {"type": "array", "minItems": 1}
  }
}
