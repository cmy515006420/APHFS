{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aphfs.invalid/schema/locked-execution-receipt-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type", "artifact_label", "status", "run_id", "role",
    "context_schema_version",
    "execution_approval_sha256", "exact_command_sha256", "execution_intent_sha256",
    "guard_path", "execution_guard_sha256", "receipt_path",
    "final_freeze_record_sha256", "base_runtime_inventory_sha256",
    "non_scientific_amendment_record_sha256", "sealed_artifact_carryforward_record_sha256",
    "amendment_review_approval_sha256", "amendment_review_bundle_sha256",
    "amended_runtime_verification_record_sha256", "amended_runtime_inventory_sha256",
    "runtime_environment_manifest_sha256", "calibration_result_bundle_sha256",
    "calibration_certificate_record_sha256", "calibration_review_approval_sha256",
    "role_manifest_raw_sha256", "role_commitment_sha256", "protocol_sha256",
    "config_sha256", "fidelity_contract_sha256", "author_final_freeze_approval_sha256",
    "locked_materialization_approval_sha256", "locked_provenance_context_sha256",
    "process_start_utc",
    "process_end_utc", "result_path", "failure_path", "result_sha256",
    "failure_sha256", "guard_permanently_retained", "retry_permitted",
    "raw_role_values_included", "exception_text_redacted"
  ],
  "properties": {
    "record_type": {"const": "LOCKED_EXECUTION_RECEIPT_V1"},
    "artifact_label": {"enum": ["PROTECTED_LOCKED_EXECUTION_RECEIPT", "TEST_ONLY_SYNTHETIC_LOCKED_EXECUTION_RECEIPT"]},
    "status": {"enum": ["LOCKED_EXECUTION_COMPLETED_ONCE", "LOCKED_EXECUTION_FAILED_AFTER_GUARD"]},
    "run_id": {"const": "aphfs_actual_locked_audit_v1"},
    "role": {"const": "locked"},
    "context_schema_version": {"const": "1"},
    "execution_approval_sha256": {"$ref": "#/$defs/hash"},
    "exact_command_sha256": {"$ref": "#/$defs/hash"},
    "execution_intent_sha256": {"$ref": "#/$defs/hash"},
    "guard_path": {"const": "protected_results/locked/.actual_locked_v1_started"},
    "execution_guard_sha256": {"$ref": "#/$defs/hash"},
    "receipt_path": {"const": "protected_results/locked/locked_execution_receipt_v1.json"},
    "final_freeze_record_sha256": {"$ref": "#/$defs/hash"},
    "base_runtime_inventory_sha256": {"$ref": "#/$defs/hash"},
    "non_scientific_amendment_record_sha256": {"$ref": "#/$defs/hash"},
    "sealed_artifact_carryforward_record_sha256": {"$ref": "#/$defs/hash"},
    "amended_runtime_inventory_sha256": {"$ref": "#/$defs/hash"},
    "amendment_review_approval_sha256": {"$ref": "#/$defs/hash"},
    "amendment_review_bundle_sha256": {"$ref": "#/$defs/hash"},
    "amended_runtime_verification_record_sha256": {"$ref": "#/$defs/hash"},
    "runtime_environment_manifest_sha256": {"$ref": "#/$defs/hash"},
    "calibration_result_bundle_sha256": {"$ref": "#/$defs/hash"},
    "calibration_certificate_record_sha256": {"$ref": "#/$defs/hash"},
    "calibration_review_approval_sha256": {"$ref": "#/$defs/hash"},
    "role_manifest_raw_sha256": {"$ref": "#/$defs/hash"},
    "role_commitment_sha256": {"$ref": "#/$defs/hash"},
    "protocol_sha256": {"$ref": "#/$defs/hash"},
    "config_sha256": {"$ref": "#/$defs/hash"},
    "fidelity_contract_sha256": {"$ref": "#/$defs/hash"},
    "author_final_freeze_approval_sha256": {"$ref": "#/$defs/hash"},
    "locked_materialization_approval_sha256": {"$ref": "#/$defs/hash"},
    "locked_provenance_context_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/hash"}]},
    "process_start_utc": {"type": "string", "minLength": 1},
    "process_end_utc": {"type": "string", "minLength": 1},
    "result_path": {"const": "protected_results/locked/locked_result_bundle_v1.json"},
    "failure_path": {"const": "protected_results/locked/locked_result_bundle_v1.json.failure.json"},
    "result_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/hash"}]},
    "failure_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/hash"}]},
    "guard_permanently_retained": {"const": true},
    "retry_permitted": {"const": false},
    "raw_role_values_included": {"const": false},
    "exception_text_redacted": {"const": true}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "LOCKED_EXECUTION_COMPLETED_ONCE"}}},
      "then": {"properties": {"result_sha256": {"$ref": "#/$defs/hash"}, "failure_sha256": {"type": "null"}}}
    },
    {
      "if": {"properties": {"status": {"const": "LOCKED_EXECUTION_FAILED_AFTER_GUARD"}}},
      "then": {"properties": {"result_sha256": {"type": "null"}, "failure_sha256": {"$ref": "#/$defs/hash"}}}
    }
  ],
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
