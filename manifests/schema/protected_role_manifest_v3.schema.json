{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aphfs.invalid/schema/protected-role-manifest-v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "label", "role", "derivation", "count", "values",
    "final_freeze_record_sha256", "runtime_inventory_sha256",
    "author_final_freeze_approval_sha256", "materialization_approval_sha256",
    "calibration_role_commitment_sha256", "generated_at_utc",
    "outcome_data_consulted", "overwrite_permitted", "commitment_sha256"
  ],
  "properties": {
    "schema_version": {"const": "3"},
    "label": {"enum": ["PROTECTED_ROLE", "TEST_ONLY_SYNTHETIC_PROTECTED_ROLE"]},
    "role": {"enum": ["calibration", "locked"]},
    "derivation": {"const": "OS_CSPRNG_SECRETS_RANDBITS_256_V1"},
    "count": {"const": 64},
    "values": {
      "type": "array",
      "minItems": 64,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 0}
    },
    "final_freeze_record_sha256": {"$ref": "#/$defs/hash"},
    "runtime_inventory_sha256": {"$ref": "#/$defs/hash"},
    "author_final_freeze_approval_sha256": {"$ref": "#/$defs/hash"},
    "materialization_approval_sha256": {"$ref": "#/$defs/hash"},
    "calibration_role_commitment_sha256": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/hash"}]
    },
    "generated_at_utc": {"type": "string", "minLength": 1},
    "outcome_data_consulted": {"const": false},
    "overwrite_permitted": {"const": false},
    "commitment_sha256": {"$ref": "#/$defs/hash"}
  },
  "allOf": [
    {
      "if": {"properties": {"role": {"const": "calibration"}}},
      "then": {"properties": {"calibration_role_commitment_sha256": {"type": "null"}}}
    },
    {
      "if": {"properties": {"role": {"const": "locked"}}},
      "then": {
        "properties": {
          "calibration_role_commitment_sha256": {"$ref": "#/$defs/hash"}
        }
      }
    }
  ],
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
