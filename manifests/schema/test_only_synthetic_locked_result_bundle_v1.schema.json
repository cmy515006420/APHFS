{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aphfs.invalid/schema/test-only-synthetic-locked-result-bundle-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "label", "role", "run_id", "protocol_sha256",
    "config_sha256", "fidelity_contract_sha256", "role_commitment_sha256",
    "manuscript_evidence", "protected_execution", "final_freeze_record_sha256",
    "runtime_inventory_sha256", "runtime_environment_manifest_sha256",
    "author_final_freeze_approval_sha256", "execution_approval_sha256",
    "benchmark_results"
  ],
  "properties": {
    "schema_version": {"const": "4"},
    "label": {"const": "TEST_ONLY_SYNTHETIC_PROTECTED_RESULT"},
    "role": {"enum": ["calibration", "locked"]},
    "run_id": {"type": "string", "minLength": 1},
    "protocol_sha256": {"$ref": "#/$defs/hash"},
    "config_sha256": {"$ref": "#/$defs/hash"},
    "fidelity_contract_sha256": {"$ref": "#/$defs/hash"},
    "role_commitment_sha256": {"$ref": "#/$defs/hash"},
    "manuscript_evidence": {"const": false},
    "protected_execution": {"const": false},
    "final_freeze_record_sha256": {"$ref": "#/$defs/hash"},
    "runtime_inventory_sha256": {"$ref": "#/$defs/hash"},
    "runtime_environment_manifest_sha256": {"$ref": "#/$defs/hash"},
    "author_final_freeze_approval_sha256": {"$ref": "#/$defs/hash"},
    "execution_approval_sha256": {"$ref": "#/$defs/hash"},
    "benchmark_results": {"type": "array", "minItems": 1}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
