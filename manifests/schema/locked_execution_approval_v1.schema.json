{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aphfs.invalid/schema/locked-execution-approval-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type", "explicit_action", "approval_status", "project",
    "project_version", "final_freeze_record_sha256", "runtime_inventory_sha256",
    "applicable_role", "applicable_result_sha256", "applicable_certificate_sha256",
    "no_retuning_declaration", "creation_timestamp_utc", "author_identifier",
    "human_readable_scope", "one_time_use_policy",
    "author_final_freeze_approval_sha256", "materialization_approval_sha256",
    "calibration_review_approval_sha256", "role_manifest_raw_sha256",
    "role_commitment_sha256", "protocol_sha256", "config_sha256", "fidelity_sha256",
    "artifact_label", "run_id", "exact_command_sha256", "intent_path",
    "guard_path", "result_path", "failure_path", "receipt_path",
    "base_final_freeze_record_sha256", "non_scientific_amendment_record_sha256",
    "sealed_artifact_carryforward_record_sha256", "base_runtime_inventory_sha256",
    "amended_runtime_inventory_sha256", "runtime_environment_manifest_sha256",
    "amended_runtime_verification_record_sha256",
    "non_scientific_amendment_review_approval_sha256",
    "amendment_review_bundle_sha256"
  ],
  "properties": {
    "record_type": {"const": "LOCKED_EXECUTION_APPROVAL_V1"},
    "artifact_label": {
      "enum": [
        "PROTECTED_LOCKED_EXECUTION_APPROVAL",
        "TEST_ONLY_SYNTHETIC_LOCKED_EXECUTION_APPROVAL"
      ]
    },
    "explicit_action": {"const": "RUN_LOCKED_AUDIT_ONCE"},
    "approval_status": {"const": "APPROVED"},
    "project": {"const": "APHFS"},
    "project_version": {"const": "1.6"},
    "final_freeze_record_sha256": {"$ref": "#/$defs/hash"},
    "runtime_inventory_sha256": {"$ref": "#/$defs/hash"},
    "applicable_role": {"const": "locked"},
    "applicable_result_sha256": {"$ref": "#/$defs/hash"},
    "applicable_certificate_sha256": {"$ref": "#/$defs/hash"},
    "no_retuning_declaration": {"const": true},
    "creation_timestamp_utc": {"type": "string", "minLength": 1},
    "author_identifier": {"type": "string", "minLength": 1},
    "human_readable_scope": {"type": "string", "minLength": 20},
    "one_time_use_policy": {"const": "NEW_WRITE_SINGLE_USE"},
    "author_final_freeze_approval_sha256": {"$ref": "#/$defs/hash"},
    "materialization_approval_sha256": {"$ref": "#/$defs/hash"},
    "calibration_review_approval_sha256": {"$ref": "#/$defs/hash"},
    "role_manifest_raw_sha256": {"$ref": "#/$defs/hash"},
    "role_commitment_sha256": {"$ref": "#/$defs/hash"},
    "protocol_sha256": {"$ref": "#/$defs/hash"},
    "config_sha256": {"$ref": "#/$defs/hash"},
    "fidelity_sha256": {"$ref": "#/$defs/hash"}
    ,
    "run_id": {"const": "aphfs_actual_locked_audit_v1"},
    "exact_command_sha256": {"$ref": "#/$defs/hash"},
    "intent_path": {"const": "protected_results/locked/locked_execution_intent_v1.json"},
    "guard_path": {"const": "protected_results/locked/.actual_locked_v1_started"},
    "result_path": {"const": "protected_results/locked/locked_result_bundle_v1.json"},
    "failure_path": {"const": "protected_results/locked/locked_result_bundle_v1.json.failure.json"},
    "receipt_path": {"const": "protected_results/locked/locked_execution_receipt_v1.json"},
    "base_final_freeze_record_sha256": {"$ref": "#/$defs/hash"},
    "non_scientific_amendment_record_sha256": {"$ref": "#/$defs/hash"},
    "sealed_artifact_carryforward_record_sha256": {"$ref": "#/$defs/hash"}
    ,
    "base_runtime_inventory_sha256": {"$ref": "#/$defs/hash"},
    "amended_runtime_inventory_sha256": {"$ref": "#/$defs/hash"},
    "runtime_environment_manifest_sha256": {"$ref": "#/$defs/hash"},
    "amended_runtime_verification_record_sha256": {"$ref": "#/$defs/hash"},
    "non_scientific_amendment_review_approval_sha256": {"$ref": "#/$defs/hash"},
    "amendment_review_bundle_sha256": {"$ref": "#/$defs/hash"}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
