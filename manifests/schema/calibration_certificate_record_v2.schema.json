{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aphfs.invalid/schema/calibration-certificate-record-v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "certificate_status",
    "final_freeze_record_sha256",
    "runtime_inventory_sha256",
    "protocol_sha256",
    "config_sha256",
    "fidelity_sha256",
    "calibration_role_commitment_sha256",
    "calibration_result_bundle_sha256",
    "K",
    "m",
    "U_CP",
    "delta",
    "calibration_beta",
    "locked_gamma",
    "event_definition",
    "Q_definition_and_version",
    "timestamp_utc",
    "no_retuning_declaration"
  ],
  "properties": {
    "schema_version": {"const": "2"},
    "certificate_status": {"const": "CALIBRATION_CERTIFICATE_GRANTED"},
    "final_freeze_record_sha256": {"$ref": "#/$defs/hash"},
    "runtime_inventory_sha256": {"$ref": "#/$defs/hash"},
    "protocol_sha256": {"$ref": "#/$defs/hash"},
    "config_sha256": {"$ref": "#/$defs/hash"},
    "fidelity_sha256": {"$ref": "#/$defs/hash"},
    "calibration_role_commitment_sha256": {"$ref": "#/$defs/hash"},
    "calibration_result_bundle_sha256": {"$ref": "#/$defs/hash"},
    "K": {"type": "integer", "minimum": 0},
    "m": {"const": 64},
    "U_CP": {"type": "number", "minimum": 0, "maximum": 1},
    "delta": {"const": 0.05},
    "calibration_beta": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
    "locked_gamma": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
    "event_definition": {"type": "string", "minLength": 1},
    "Q_definition_and_version": {"const": "APHFS-D2-CERT-Q-V6"},
    "timestamp_utc": {"type": "string", "minLength": 1},
    "no_retuning_declaration": {"const": true}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
