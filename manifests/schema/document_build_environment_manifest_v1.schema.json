{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aphfs.invalid/schema/document-build-environment-manifest-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "purpose", "operating_system", "python", "tools", "document_distributions", "builder_hashes"],
  "properties": {
    "schema_version": {"const": "1"},
    "purpose": {"const": "MANUSCRIPT_AND_CROSS_PLATFORM_RENDER_REPRODUCIBILITY_ONLY"},
    "operating_system": {"type": "object", "required": ["system", "release", "architecture"]},
    "python": {"type": "object", "required": ["implementation", "version"]},
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "required": ["libreoffice", "tectonic", "pdfinfo", "pdftoppm"],
      "properties": {
        "libreoffice": {"$ref": "#/$defs/tool"},
        "tectonic": {"$ref": "#/$defs/tool"},
        "pdfinfo": {"$ref": "#/$defs/tool"},
        "pdftoppm": {"$ref": "#/$defs/tool"}
      }
    },
    "document_distributions": {"type": "array", "items": {"type": "object", "required": ["name", "version"]}},
    "builder_hashes": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/hash"}}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basename", "version", "sha256"],
      "properties": {
        "basename": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/hash"}
      }
    }
  }
}
